{
  "name": "local-lore",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --port 4317",
    "build": "next build --webpack",
    "build:vercel": "next build --webpack",
    "start": "next start --port 4317",
    "test": "npm run build:vercel && tsx --test tests/source-catalog.test.mjs tests/ingestion.test.ts tests/source-audit.test.mjs tests/discovery-publisher.test.mjs",
    "lint": "eslint app components lib db scripts types next.config.ts eslint.config.mjs",
    "catalog:validate": "node scripts/validate-source-catalog.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:setup": "npm run db:migrate",
    "catalog:research": "node scripts/discover-catalog.mjs research",
    "catalog:stage": "node scripts/discover-catalog.mjs stage",
    "catalog:apply": "node scripts/discover-catalog.mjs apply",
    "catalog:daily": "node scripts/daily-discovery.mjs",
    "catalog:schedule": "node scripts/schedule-discovery.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@types/pg": "^8.20.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "pmtiles": "^4.4.1",
    "posthog-js": "^1.410.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
